# POST-STAGE-4.4 REFERENCE — what a complete register looks like AFTER the
# human decision has actually happened. Compare your own register's decisions:
# section against this only after you have completed Stage 4.4.
#
# If you are reading this before Stage 4.4, you are looking at the answer
# before you've earned it.

objective: >
  Implement RTP transfer fee support in calculateFee() per MFIN-2088.

verified_facts:
  - claim: "RTP fee is 0.35% of amount with a USD 2.00 minimum, applied to the computed fee"
    source: "config/fee-schedule.yaml"
    source_type: "committed configuration"
    applies_to: "calculateFee-rtp"
  - claim: "WIRE fee is 0.25%, current"
    source: "config/fee-schedule.yaml"
    source_type: "committed configuration"
  - claim: "LegacyPaymentUtils WIRE rate (1%) is retired, never current"
    source: "src/main/java/com/meridian/payments/legacy/LegacyPaymentUtils.java"
    source_type: "bytecode (jdeps: 0 references from PaymentService)"

authoritative_sources:
  - "config/fee-schedule.yaml"

decisions:
  - decision: "The USD 2.00 minimum compares against the computed fee, not the raw amount"
    approved_by: "human, Stage 4.4"
  - decision: "config/fee-schedule.yaml supersedes docs/adr/ADR-0007-fee-schedule.md"
    approved_by: "human, Stage 4.4"

constraints:
  - "Never call LegacyPaymentUtils"
  - "Never inline a fee rate outside calculateFee"

superseded_sources:
  - source: "docs/adr/ADR-0007-fee-schedule.md"
    superseded_by: "config/fee-schedule.yaml"
    warning: "cites 0.30% flat, no minimum — do not implement from this"

unknowns:
  - "Should calculateFee read config/fee-schedule.yaml at runtime instead of a hardcoded constant?"
